{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runner-os",
  "compatibility_date": "2025-09-01",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runner-os-production",
      "database_id": "REPLACE_AFTER_D1_CREATION",
      "migrations_dir": "migrations"
    }
  ]
}
